# ============================================================
# FORMA & FUNÇÃO CRM — variáveis de ambiente
# Copie para .env.local e preencha os valores reais.
# NUNCA comite .env.local no git.
# ============================================================

# ⚠️  ATENÇÃO — NEXT_PUBLIC_APP_URL
# Deve ser a URL de produção no Vercel (ex: https://forma-funcao-crm.vercel.app).
# Se ficar como "http://localhost:3000", os links de assinatura gerados pelo
# sistema apontarão para localhost — o paciente receberá "conexão recusada"
# ao tentar assinar o contrato.
NEXT_PUBLIC_APP_URL=https://forma-funcao-crm.vercel.app

# Supabase — obter em: https://supabase.com/dashboard/project/<seu-projeto>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SEU_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SEU_SERVICE_ROLE_KEY

# Assinatura digital própria
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Usado para HMAC dos tokens de assinatura. OBRIGATÓRIO — sem ele, assinaturas
# são rejeitadas com erro 500.
SIGNING_HMAC_SECRET=

# E-mail transacional via Resend (https://resend.com — plano free: 3 000 e-mails/mês)
# Usado para enviar PDF assinado ao paciente e notificar a clínica.
# Se ausente, e-mails não são enviados (não bloqueia a assinatura).
RESEND_API_KEY=re_

# Google Drive (service account)
# Criar service account em: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
DRIVE_ROOT_FOLDER_ID=ID_DA_PASTA_RAIZ_NO_DRIVE

# ZapSign — assinatura digital externa (legado; sistema usa assinatura própria atualmente)
# https://app.zapsign.com.br
ZAPSIGN_API_TOKEN=SEU_TOKEN_ZAPSIGN
ZAPSIGN_WEBHOOK_SECRET=SEU_SECRET

# Vindi — pagamentos recorrentes (https://app.vindi.com.br)
VINDI_API_KEY=SEU_API_KEY_VINDI
VINDI_WEBHOOK_SECRET=SEU_SECRET

# WhatsApp (Z-API ou Evolution API)
WHATSAPP_API_URL=https://api.z-api.io/instances/SEU_INSTANCE
WHATSAPP_API_TOKEN=SEU_TOKEN

# Stripe — pagamentos online (https://dashboard.stripe.com/apikeys)
# STRIPE_SECRET_KEY nunca vai para o bundle client (só server-side)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET: obter em Stripe Dashboard > Webhooks > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
